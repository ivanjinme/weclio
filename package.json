{
  "name": "@weclio/pi-web",
  "version": "0.1.20",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/ivanjinme/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanjinme/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/ivanjinme/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "weclio-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:desktop": "node electron/dev.mjs",
    "dev:web": "next dev -H 127.0.0.1 -p 8888",
    "dev:lan": "next dev -H 0.0.0.0 -p 8888",
    "build:desktop": "node electron/build.mjs",
    "pack:desktop": "npm run build:desktop && electron-builder --config electron/builder.json --win --x64 --dir",
    "dist:desktop": "npm run build:desktop && electron-builder --config electron/builder.json --win --x64",
    "release:desktop": "node electron/release.mjs",
    "setup:desktop-updates": "node electron/update-release.mjs --init",
    "fixture:desktop-update": "node electron/update-fixture.mjs",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 8888",
    "start:lan": "next start -H 0.0.0.0 -p 8888",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "build:desktop-ui": "vite build",
    "dev:desktop-ui": "vite --config vite.config.ts",
    "dev:service-ui": "node electron/dev-service-ui.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@lexical/react": "0.48.0",
    "@mdxeditor/editor": "4.3.2",
    "@weclio/plugins": "0.1.5",
    "codemirror": "6.0.2",
    "electron-updater": "6.8.11",
    "lexical": "0.48.0",
    "next": "16.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "8.12.4",
    "weclio-cli": "0.3.6"
  },
  "devDependencies": {
    "@lobehub/icons": "6.15.2",
    "@lobehub/ui": "6.15.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jiti": "^2.7.0",
    "katex": "0.19.1",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vite": "^7.3.8"
  },
  "overrides": {
    "katex": "$katex",
    "app-builder-lib@26.18.0": {
      "minimatch@10.2.6": "11.0.8"
    },
    "@electron/universal@2.0.3": {
      "minimatch@9.0.9": "11.0.8"
    },
    "@typescript-eslint/typescript-estree@8.72.2": {
      "minimatch@10.2.6": "11.0.8"
    }
  }
}
