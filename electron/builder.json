{
  "appId": "com.weclio.desktop",
  "productName": "Weclio",
  "directories": {
    "output": "build/desktop/dist",
    "buildResources": "public/brand"
  },
  "files": [
    "electron/main.mjs",
    "lib/startup-splash.mjs",
    "electron/navigation.mjs",
    "electron/protocol.mjs",
    "electron/preload.cjs",
    "electron/updates.mjs",
    "electron/update-signature.mjs",
    "electron/update-install.mjs",
    "electron/local-service.mjs",
    "electron/service-control.mjs",
    "electron/system-node.mjs",
    "bin/node-version.js",
    "lib/agent/protocol/version-value.mjs",
    "electron/runtime.mjs",
    "electron/toolsets.mjs",
    "LICENSE",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "name": "weclio",
    "main": "electron/main.mjs",
    "description": "Weclio - Build an AI Scientist"
  },
  "extraResources": [
    {
      "from": "resources",
      "to": ".",
      "filter": [
        "desktop-update.json"
      ]
    },
    {
      "from": "build/desktop/ui",
      "to": "ui"
    },
    {
      "from": "build/desktop/service",
      "to": "service",
      "filter": ["entry.mjs", "package.json", "service-manifest.json", "lib/**/*", "electron/packages.mjs", "LICENSE"]
    },
    {
      "from": "build/desktop/service/node_modules",
      "to": "service/node_modules"
    },
    {
      "from": "build/desktop/host",
      "to": "host",
      "filter": ["package.json", "host-manifest.json", "LICENSE"]
    },
    {
      "from": "build/desktop/host/node_modules",
      "to": "host/node_modules"
    },
    {
      "from": "build/desktop/toolset.json",
      "to": "desktop-toolset.json"
    },
    {
      "from": "resources/runtime/win-x64",
      "to": "runtime/win-x64",
      "filter": [
        "tools/**/*"
      ]
    }
  ],
  "electronDist": "node_modules/electron/dist",
  "asar": true,
  "npmRebuild": false,
  "publish": null,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/brand/app-icon.ico",
    "signAndEditExecutable": false,
    "artifactName": "Weclio-${version}-${arch}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false
  }
}
